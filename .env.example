# Copy this file to .env (or export these in your shell) and fill in what you need.
# Everything here is OPTIONAL — the app runs fine with none of it set.

# Flask session signing key. Change this for any real deployment.
SECRET_KEY=change-me-in-production

# Path to the tesseract binary, only needed if it's not already on your PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Telegram bot used to alert on flagged accounts. Leave blank to just log to console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
